{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "migas",
  "version": "0.2.5",
  "identifier": "es.migas.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "migas",
        "url": "index.html",
        "width": 1380,
        "height": 880,
        "minWidth": 760,
        "minHeight": 540,
        "decorations": false,
        "center": true,
        "visible": false
      },
      {
        "label": "rapida",
        "title": "migas · guardar",
        "url": "rapida.html",
        "width": 620,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "shortDescription": "Diario de enlaces y notas",
    "category": "Productivity"
  }
}